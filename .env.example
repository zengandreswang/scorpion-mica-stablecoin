# Deployer wallet private key (without 0x prefix if using vm.envUint, or with 0x in standard format)
PRIVATE_KEY=your_sepolia_wallet_private_key_here

# RPC Endpoint for Ethereum Sepolia Testnet (e.g., Alchemy / Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Optional: Etherscan API Key for automated contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
